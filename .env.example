# PowerShell environment examples. The launcher does not load .env automatically.
# Set values in the launching shell or pass launcher arguments.

# SDK path is machine-local; omit only when installed in an automatic SDK location.
# ICS_ZWO_SDK_LIBRARY=C:\vendor\ASICamera2.dll
# Default profile when unset: config/cameras.sim.json
# ICS_BETA_CAMERA_CONFIG=config/cameras.lhires-dual-zwo.example.json

# Explicit camera simulation; unavailable real science hardware never auto-falls back.
# ICS_BETA_FORCE_SIM=1
# JUSTLS_AUTO_READOUT_ENABLED=1
# JUSTLS_SLIT_PREVIEW_AUTOSTART=1
# Windows PnP presence interval, 0 disables; this is not SDK re-enumeration.
# ICS_BETA_HOTPLUG_INTERVAL_S=30

# Highest-priority output root (overrides operator-selected root and profile).
# ICS_BETA_DATA_ROOT=D:\observations\ics-beta
# JUSTLS_SETUP_CONTEXT_PATH=.justls/setup_context.json
# JUSTLS_SEQUENCE_STATE_PATH=.justls/sequence_execution.json
# JUSTLS_INSTRUMENT_CONTEXT_PATH=.justls/instrument_context.json
# JUSTLS_OUTPUT_LOCATION_PATH=.justls/output_location.json
