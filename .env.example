# ICS Beta — environment variables
#
# Copy this file to `.env` (or paste the lines into your shell session) and
# adjust for your local install. The defaults below match a typical Windows
# laptop setup. The service still works without any of these set, but
# setting them up front keeps the operator console predictable.
#
# To see which env vars the service currently reads at runtime, hit
# `/api/v1/system/status` (or `/`) — the response lists the env-var driven
# switches that affect UI/runtime behaviour.

# --- SDK / driver locations --------------------------------------------------

# Absolute path to the ZWO vendor library. The installer places it under
# C:\Program Files\ASIStudio\ASICamera2.dll; this project has historically
# used the F:\ASIStudio copy as well. If unset, the service falls back to
# the install defaults, then to the CWD.
# ICS_ZWO_SDK_LIBRARY=F:\ASIStudio\ASICamera2.dll

# Which camera profile to load. Default (when unset) is
# `config/cameras.zwo.example.json`. Use `cameras.sim.json` for a fully
# simulated deployment that does not touch the SDK at all.
# ICS_BETA_CAMERA_CONFIG=config/cameras.lhires-dual-zwo.example.json

# --- Safe mode (USE WHEN THE ZWO SDK IS STUCK) -------------------------------

# Force every ZWO driver into the simulated fallback. The service stays
# usable for UI work and software development while a real hardware
# problem is being repaired. There is no need to delete this once
# hardware is back — simply remove the line (or set it to 0) and restart
# the service.
#
# ICS_BETA_FORCE_SIM=1

# --- Hot-plug monitor --------------------------------------------------------

# How often (seconds) the background monitor asks the SDK how many cameras
# it sees. Set to 0 to disable the monitor (rarely useful; the monitor is
# already disabled automatically when no ZWO driver is bound, e.g. when
# ICS_BETA_FORCE_SIM=1 or a sim-only camera config is loaded).
#
# ICS_BETA_HOTPLUG_INTERVAL_S=30

# --- Slit preview behaviour --------------------------------------------------

# By default the slit/guide live view starts automatically when the
# service is up, so the operator can confirm the star is on the slit
# without an extra click. Set to 0 to require a manual start.
#
# JUSTLS_SLIT_PREVIEW_AUTOSTART=1

# --- Output location ---------------------------------------------------------

# Where saved science frames go. ``ICS_BETA_DATA_ROOT`` is the highest
# priority source; if unset the service uses the operator's last choice
# (kept in `.justls/output_location.json`) or the value of
# ``data_root`` in the camera config file.
#
# ICS_BETA_DATA_ROOT=D:\observations\20261014

# --- Sequence persistence ----------------------------------------------------

# Path to the JSON file used to recover an interrupted sequence on the
# next service start. Defaults to `.justls/sequence_state.json` next to
# the rest of the runtime state.
#
# JUSTLS_SEQUENCE_STATE_PATH=.justls/sequence_state.json
